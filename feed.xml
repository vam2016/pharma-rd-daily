---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<feed xmlns="http://www.w3.org/2005/Atom"><title>{{ site.title | xml_escape }}</title><id>{{ '/' | absolute_url | xml_escape }}</id><link href="{{ '/feed.xml' | absolute_url | xml_escape }}" rel="self"/><link href="{{ '/' | absolute_url | xml_escape }}"/><updated>{{ site.time | date_to_xmlschema }}</updated><author><name>{{ site.title | xml_escape }}</name></author>{% for post in site.posts limit: 30 %}<entry><title>{{ post.title | xml_escape }}</title><link href="{{ post.url | absolute_url | xml_escape }}"/><id>{{ post.url | absolute_url | xml_escape }}</id><published>{{ post.date | date_to_xmlschema }}</published><updated>{{ post.updated_at | default: post.date | date_to_xmlschema }}</updated><summary>{{ post.summary | xml_escape }}</summary><content type="html">{{ post.content | replace: '<script type="math/tex">', '<code>' | replace: '<script type="math/tex; mode=display">', '<code>' | replace: '</script>', '</code>' | xml_escape }}</content></entry>{% endfor %}</feed>
